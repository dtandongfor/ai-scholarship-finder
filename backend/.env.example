# Comma-separated browser origins permitted to call the production API.
# Replace this example with the real deployed frontend address.
INTELLIBLE_ALLOWED_ORIGINS=https://your-intellible-domain.example

# Production only: paste the complete Neon connection string in Render's
# Environment settings. Never commit the real value to GitHub.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
